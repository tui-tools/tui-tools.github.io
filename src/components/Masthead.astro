---
const { section = "" } = Astro.props;

// The canonical order the packages index repeats, so the two sites read as one
// bar. Packages lives on its own host; it is a normal link, not a new tab.
const links = [
  { id: "tools", href: "/", label: "Tools" },
  { id: "install", href: "/install/", label: "Install" },
  { id: "packages", href: "https://pkgs.tui.tools/", label: "Packages", external: true },
  { id: "security", href: "/security/", label: "Security" },
  { id: "kit", href: "/kit/", label: "Kit" },
];
---

<header class="masthead">
  <div class="page masthead-inner">
    <a class="brand" href="/">
      <img src="/brand/icon.svg" alt="" width="26" height="26" />
      <span><span class="prefix">tui-</span>tools</span>
    </a>
    <nav class="nav" aria-label="Main">
      {
        links.map((link) => (
          <a
            href={link.href}
            rel={link.external ? "noopener" : undefined}
            aria-current={section === link.id ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a href="https://github.com/tui-tools" rel="noopener">GitHub</a>
    </nav>
  </div>
</header>
