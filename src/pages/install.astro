---
import Base from "../layouts/Base.astro";
import CommandDialog from "../components/CommandDialog.astro";
import catalog from "../data/catalog.json";

const tools = catalog.tools.filter((tool) => !tool.unreleased);
const anyName = tools[0]?.name ?? "tui-firewall";

// Whether the package repository actually answers is decided once, at build
// time, by scripts/build-catalog.mjs: it sends a HEAD to pkgs.tui.tools and
// records the answer in the catalog. This page reads that rather than
// guessing, so it says "coming soon" until the day the repository is really
// there and then stops saying it without anyone editing a file.
const pkgs = catalog.pkgs ?? { url: "https://pkgs.tui.tools", live: false };
const live = pkgs.live === true;

// The per-manager setup is generated from the same table that writes it into
// every tool's README, and reaches this page through the catalog. Taking it
// from a tool rather than restating it here is what keeps the site and the
// repositories from disagreeing.
const channels = (id) =>
  tools.map((tool) => tool.install.find((entry) => entry.id === id)).filter(Boolean);
const setupFor = (id) => channels(id).find((entry) => entry.setup)?.setup ?? null;
// A channel is offered as working when at least one released tool can actually
// be installed through it. One tool is enough: the repository is the family's,
// not the tool's, and the setup is the same either way.
const readyFor = (id) => channels(id).some((entry) => entry.available === true);

const managers = [
  {
    id: "pacman",
    label: "Arch Linux",
    manager: "pacman",
    install: `sudo pacman -S ${anyName}`,
    setup: setupFor("pacman"),
    ready: readyFor("pacman"),
  },
  {
    id: "aur",
    label: "Arch Linux (AUR)",
    manager: "an AUR helper",
    install: `paru -S ${anyName}-bin`,
    // The AUR needs no repository: a helper builds from a PKGBUILD. Nobody has
    // published one for this family yet.
    setup: null,
    ready: false,
    note: "The AUR needs no setup beyond a helper such as paru or yay. No PKGBUILD is published yet; the signed repository above is the supported route on Arch.",
  },
  {
    id: "apt",
    label: "Debian / Ubuntu",
    manager: "apt",
    install: `sudo apt install ${anyName}`,
    setup: setupFor("apt"),
    ready: readyFor("apt"),
  },
  {
    id: "dnf",
    label: "Fedora / RHEL",
    manager: "dnf",
    install: `sudo dnf install ${anyName}`,
    setup: setupFor("dnf"),
    ready: readyFor("dnf"),
  },
  {
    id: "zypper",
    label: "openSUSE",
    manager: "zypper",
    install: `sudo zypper install ${anyName}`,
    // The rpm repository would probably serve zypper unchanged, but nothing
    // has verified that, so it stays coming soon rather than being asserted.
    setup: null,
    ready: false,
    note: "The rpm repository is the same one dnf uses, and it would very likely serve zypper unchanged. Nothing has verified that, so it is not claimed here.",
  },
];

const anyReady = managers.some((manager) => manager.ready);
---

<Base
  title="Install"
  description="How to install tui-tools: one command adds the package repository, then apt, dnf or pacman installs any tool in the family. Static binaries and checksums too."
  section="install"
  ogSlug="install"
>
  <div class="page">
    <section class="hero" style="grid-template-columns:1fr">
      <div>
        <p class="eyebrow">Install</p>
        <h1>Set the repository up once, then install any tool</h1>
        <p class="lede">
          {
            anyReady ? (
              <>
                A tool from this family is installed the way everything else on
                your machine is: <code>pacman -S</code>,
                <code>apt install</code>, <code>dnf install</code>. One command
                adds the repository, and after that upgrades arrive with the
                rest of your system updates.
              </>
            ) : (
              <>
                The family is heading for real distribution packages, so a tool
                is installed the way everything else on your machine is:
                <code>pacman -S</code>, <code>apt install</code>,
                <code>dnf install</code>. The releases already carry the
                packages; the repository serving them is not live yet. What
                works today is the static binary, and it is one command.
              </>
            )
          }
        </p>
      </div>
    </section>

    <section class="section" style="padding-top:0" id="beta">
      <div class="panel panel-beta">
        <div class="section-head" style="margin-bottom:0.75rem">
          <h2 style="margin:0">Before you install</h2>
          <span class="chip chip-beta">beta</span>
        </div>
        <p style="font-size:0.92rem;color:var(--muted)">
          The first releases are days old — 29 and 30 August 2026 — and the
          releases, the signing and the package repository pipeline were all
          rebuilt this week. Nothing here is settled yet, so read these three
          before running the commands below.
        </p>
        <ul class="beta-notes">
          <li>
            <code>tui-tools</code> changed meaning today. It used to be the
            metapackage that installed everything; it is now the launcher, and
            it carries an epoch (<code>1:0.1.0</code>) so that
            <code>apt</code>, <code>dnf</code> and <code>pacman</code> offer it
            over the older metapackage of the same name. An upgrade on a machine
            that already had it will replace the metapackage with the launcher.
          </li>
          <li>
            <code>tui-tools-all</code> is the new install-everything package. If
            what you wanted was the whole family in one command, that is the
            name to ask for now.
          </li>
          <li>
            The repository signing key may be rotated once more before 1.0.
            <code>install.sh</code> re-imports the current key each time it runs,
            so re-running it is the supported way through a rotation; a setup
            done by hand has to import the new key by hand.
          </li>
        </ul>
        <p style="font-size:0.92rem;color:var(--muted);margin-bottom:0">
          Until the family is declared stable, package names, flags, keys and
          key bindings can change without a deprecation period. Pin the versions
          you depend on, and
          <a href="https://github.com/tui-tools" rel="noopener">report what breaks</a>.
        </p>
      </div>
    </section>

    {
      anyReady && (
        <section class="section" style="padding-top:0" id="script">
          <div class="section-head">
            <h2>One command, whichever distribution</h2>
            <span class="chip chip-version">works now</span>
          </div>
          <div class="split">
            <div>
              <CommandDialog
                title="Detect the package manager and add the repository"
                command={`curl -fsSL ${pkgs.url}/install.sh | sh`}
                manager="install-script"
              />
            </div>
            <div class="panel">
              <h2>Read it first</h2>
              <p style="font-size:0.9rem;color:var(--muted)">
                A family whose whole promise is <em>preview before you run</em>
                does not ask you to pipe a script into a shell without looking
                at it. The script prints every privileged command before running
                it, and <code>--dry-run</code> prints them without running
                anything.
              </p>
              <p style="font-size:0.9rem;color:var(--muted);margin-bottom:0">
                <code>curl -fsSL {pkgs.url}/install.sh -o install.sh</code> and
                read it, or take the commands by hand from the section below —
                they are the same ones.
              </p>
            </div>
          </div>
        </section>
      )
    }

    <section class="section" style="padding-top:0" id="today">
      <div class="section-head">
        <h2>{anyReady ? "Or the static binary" : "Today: the static binary"}</h2>
        <span class="chip chip-version">works now</span>
      </div>
      <div class="split">
        <div class="stack">
          {
            tools.map((tool) => {
              const binary = tool.install.find((entry) => entry.id === "binary");
              if (!binary) return null;
              return (
                <CommandDialog
                  title={`${tool.name} ${tool.release?.tag ?? ""} · linux/amd64`}
                  command={binary.commands[0].command}
                  tool={tool.name}
                  manager="binary"
                />
              );
            })
          }
        </div>
        <div class="panel">
          <h2>Other architectures</h2>
          <p style="font-size:0.9rem;color:var(--muted)">
            Every release ships <code>linux/amd64</code> and <code>linux/arm64</code>.
            Each tool's page lists both, with the file sizes and the SHA-256 sums
            taken from the release's own <code>checksums.txt</code>.
          </p>
          <p style="font-size:0.9rem;color:var(--muted);margin-bottom:0">
            No installer script runs on your machine, and the tools never check for
            updates: you upgrade by downloading a newer binary.
          </p>
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:0" id="repositories">
      <div class="section-head">
        <h2>{anyReady ? "The setup, by hand" : "Coming: one repository, every tool"}</h2>
        {
          anyReady ? (
            <span class="chip chip-version">works now</span>
          ) : (
            <span class="chip chip-unreleased">not live yet</span>
          )
        }
      </div>
      <p class="lede" style="max-width:62ch">
        {
          anyReady ? (
            <>
              What the one-liner does, spelled out. Three or four commands per
              distribution: import the signing key, point the package manager at
              the repository, refresh.
            </>
          ) : (
            <>
              These are the commands the family is building towards. They are
              written down now so the shape is public and reviewable; nothing at
              <code>{pkgs.url.replace("https://", "")}</code> answers yet, so
              running them today will fail.
            </>
          )
        }
      </p>

      <div class="stack" style="margin-top:2rem">
        {
          managers.map((manager) => (
            <section class="panel" id={manager.id}>
              <h2>
                {manager.label}
                {!manager.ready && (
                  <span class="chip chip-unreleased" style="margin-left:0.6rem">
                    coming soon
                  </span>
                )}
              </h2>
              <div class="stack" style="margin-top:0">
                {manager.setup ? (
                  <>
                    <CommandDialog
                      title="Add the repository and its signing key"
                      command={manager.setup.manual}
                      manager={manager.id}
                      soon={!manager.ready}
                    />
                    <CommandDialog
                      title="Then install any tool"
                      command={manager.install}
                      tool={anyName}
                      manager={manager.id}
                      soon={!manager.ready}
                    />
                  </>
                ) : (
                  <>
                    <CommandDialog
                      title="Then install any tool"
                      command={manager.install}
                      tool={anyName}
                      manager={manager.id}
                      soon
                    />
                    <p class="install-note">{manager.note}</p>
                  </>
                )}
              </div>
              {manager.setup && (
                <p class="install-note">
                  One setup per machine. After it, every tool in the family is a
                  <code>{manager.manager}</code> away, and upgrades come with the
                  rest of your system updates.
                </p>
              )}
            </section>
          ))
        }
      </div>
    </section>

    <section class="section" style="padding-top:0" id="verify">
      <div class="section-head">
        <h2>Verify a download</h2>
      </div>
      <div class="split">
        <div class="stack">
          <CommandDialog
            title="Check an archive against the release's checksums.txt"
            command={`curl -fsSLO https://github.com/tui-tools/${anyName}/releases/latest/download/checksums.txt
sha256sum -c checksums.txt --ignore-missing`}
            manager="checksums"
          />
          <p style="color:var(--muted);font-size:0.92rem">
            <code>--ignore-missing</code> checks only the files you actually
            downloaded. The command prints <code>OK</code> per file, and exits
            non-zero if anything does not match.
          </p>
        </div>
        <div class="panel">
          <h2>Signatures</h2>
          <p style="font-size:0.9rem;color:var(--muted)">
            The tarballs on a GitHub release are <strong>not signed</strong>;
            <code>checksums.txt</code> tells you one arrived intact, which is not
            the same as proving who built it.
          </p>
          <p style="font-size:0.9rem;color:var(--muted);margin-bottom:0">
            The <strong>packages are</strong>. Every <code>.deb</code>,
            <code>.rpm</code> and <code>.pkg.tar.zst</code> in the repository is
            signed by one key, and so is each repository's index — the apt
            <code>Release</code>, the dnf <code>repomd.xml</code>, the pacman
            database. Your package manager checks all of it before installing,
            which is the real reason to prefer this route over a tarball. The key
            is at <code>{pkgs.url}/pubkey.asc</code>, and the
            <a href="/security/">security page</a> has the rest.
          </p>
        </div>
      </div>
    </section>
  </div>
</Base>
