---
// The site-wide beta notice. It is deliberately plain: one line, no JavaScript,
// no dismiss button. Most of the family is still beta, and a beta tool's keys,
// flags and output can still change before its 1.0, so a reader who never
// scrolls should still leave the page knowing that. It goes away when the
// family is declared stable, and that removal is a 1.0 decision, not a tidy-up.
//
// The sentence is canonical: /catalog.json serves it as `family.notice`, so the
// two are changed together or not at all. The banner shows "Beta" as its own tag and the rest as the line,
// which reads as the same sentence with its first word set apart.
//
// A tool can leave beta before the family does. When one has, the banner names
// it after the sentence, read from the catalog, so the line stays true without
// anyone editing it when the next tool is promoted.
import catalog from "../data/catalog.json";
import { STABILITY_DOC, stableTools } from "../lib/stability.js";

const stable = stableTools(catalog);
---

<aside class="beta-banner" aria-label="Project status">
  <p class="page beta-banner-inner">
    <span class="beta-banner-tag">Beta</span>
    <span
      >tools may still change keys, flags or output before their 1.0; stable
      tools follow semver. Pin versions, and report what breaks.</span
    >
    {
      stable.length > 0 && (
        <span class="beta-banner-stable">
          Stable, and following semver:{" "}
          {stable.map((tool, index) => (
            <>
              {index > 0 && ", "}
              <a href={`/tools/${tool.name}/`}>{tool.name}</a> since {tool.since}
            </>
          ))}
          . <a href={STABILITY_DOC} rel="noopener">What stable means</a>
        </span>
      )
    }
    <a href="/install/#beta">Before you install</a>
  </p>
</aside>
