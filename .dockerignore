# Everything the image build does not read. node_modules and dist above all:
# they are rebuilt inside the image, and sending a local copy would both slow
# the build and risk baking a stale one in.
.git
.github
node_modules
dist
.astro
docs
README.md
LICENSE
Dockerfile
.dockerignore

# Generated by the catalog step inside the image; a local copy must not be
# carried in, or a rate-limited build would silently ship yesterday's catalog.
src/data/catalog.json
public/tools
