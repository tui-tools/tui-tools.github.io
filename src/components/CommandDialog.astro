---
// The site's one borrowed idea: every tool in the family shows a command in a
// box and asks y or n before it runs. Installing a tool is previewed the same
// way, and the copy button is the y key.
// `tool` and `manager` are only there to label the analytics event: which tool
// the command belongs to, and which package manager it installs with. They are
// optional, so a dialog that is not an install command stays plain.
const { title, command, soon = false, sigil = "$", tool = "", manager = "" } = Astro.props;
const lines = command.split("\n");

// The copy button is rendered twice: once in the title row and once beside the
// command. On a phone the command needs the full width to scroll in, so the
// title-row copy is the visible one; from 34rem up the one beside the command
// takes over. Only ever one of them is in the accessibility tree, because the
// other is `display: none`.
const copyProps = {
  type: "button",
  "data-copy": command,
  "data-copied": "false",
  "data-umami-event": "install-copy",
  "data-umami-event-tool": tool || "family",
  "data-umami-event-manager": manager || "none",
  "aria-label": `Copy: ${lines[0]}`,
};
---

<div class:list={["dialog", { "is-soon": soon }]}>
  <div class="dialog-title">
    <span class="lhs">{title}</span>
    <span class="rhs">
      {soon && <span class="chip chip-unreleased">coming soon</span>}
      <button class="copy copy-in-title" {...copyProps}>
        <span class="key" aria-hidden="true">y</span>
        <span data-copy-label>copy</span>
      </button>
    </span>
  </div>
  <div class="dialog-body">
    <pre><code>{lines.map((line, index) => (
      <span>{index === 0 ? <span class="sigil">{sigil} </span> : <span class="sigil">  </span>}{line}{index < lines.length - 1 ? "\n" : ""}</span>
    ))}</code></pre>
    <button class="copy copy-beside" {...copyProps}>
      <span class="key" aria-hidden="true">y</span>
      <span data-copy-label>copy</span>
    </button>
  </div>
</div>
