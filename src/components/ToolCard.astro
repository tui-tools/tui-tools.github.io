---
import VersionChip from "./VersionChip.astro";

const { tool } = Astro.props;

const shot = tool.screenshots[0];
const version = tool.release?.tag ?? null;
const platforms = tool.platforms.map((p) => p.split("/")[1]).join(", ");
const rest = tool.name.replace(/^tui-/, "");

/**
 * A download URL is long in the middle and meaningful at both ends, so the
 * card elides the middle: the reader still sees `curl -fsSL` and the archive
 * name. Truncating the end would leave nothing but the host.
 */
function elide(command, limit = 44) {
  if (command.length <= limit) return command;
  const head = Math.ceil((limit - 1) * 0.42);
  const tail = limit - 1 - head;
  return `${command.slice(0, head)}…${command.slice(-tail)}`;
}

const headline = tool.headline ? elide(tool.headline.command) : null;

/**
 * The card says which program the tool drives and the floor it claims — "ufw ≥
 * 0.36" — because that is the one compatibility fact worth knowing before
 * opening the page. A backend with no declared minimum contributes its name
 * alone; a tool that drives nothing contributes nothing. Every backend is
 * listed: a tool that drives three package managers must not look like it
 * drives two, and the chips wrap.
 */
const backendHints = (tool.backends ?? []).map((backend) =>
  backend.minimum ? `${backend.binary} ≥ ${backend.minimum}` : backend.binary,
);
---

<article class="card">
  <div class="card-head">
    {tool.icon && <img src={tool.icon} alt="" width="34" height="34" loading="lazy" />}
    <div>
      <h3 class="card-name">
        <a href={`/tools/${tool.name}/`}><span class="prefix">tui-</span>{rest}</a>
      </h3>
    </div>
    <span class="card-version">
      <VersionChip tag={version} />
    </span>
  </div>

  {
    shot && (
      <div class="card-shot">
        <img src={shot.src} alt={shot.caption} loading="lazy" width="1040" height="260" />
      </div>
    )
  }

  <div class="card-body">
    <p class="card-tagline">{tool.tagline}</p>
    <div class="card-meta">
      <span class="chip chip-category">{tool.category}</span>
      <span class="chip">linux · {platforms}</span>
      {backendHints.map((hint) => <span class="chip chip-backend">{hint}</span>)}
    </div>
    {
      headline && (
        <p class="card-install" title={tool.headline.command}>
          <span class="sigil">$</span> {headline}
        </p>
      )
    }
  </div>
</article>
