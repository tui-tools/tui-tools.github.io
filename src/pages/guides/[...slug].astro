---
// One guide.
//
// getStaticPaths goes through the same `publishedGuides()` the index uses, so
// a draft has no page at all: not a hidden one, not one reachable by guessing
// the URL.
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { publishedGuides, guideDate, isoDay } from "../../lib/guides.js";
import catalog from "../../data/catalog.json";
import { breadcrumbList, techArticle } from "../../lib/jsonld.js";
import { guideTitle } from "../../lib/seo.js";
import { ogImageUrl } from "../../lib/og.js";

export async function getStaticPaths() {
  const guides = await publishedGuides();
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);

// A named tool only becomes a link when it is really in the catalog; a typo in
// the frontmatter should read as plain text rather than as a link to a 404.
const known = new Set(catalog.tools.map((tool) => tool.name));
const tools = guide.data.tools.map((name) => ({ name, known: known.has(name) }));

const url = `/guides/${guide.id}/`;

// Each guide has its own card, drawn by scripts/build-og.mjs from the same
// frontmatter; the page and its structured data point at the same URL.
const ogSlug = `guides/${guide.id}`;
const ogImage = ogImageUrl({ slug: ogSlug, base: Astro.site });

// The search-facing strings: a short `seoDescription` when the lede is longer
// than a result shows, and a `<title>` that fits (see guideTitle).
const seoDescription = guide.data.seoDescription ?? guide.data.description;
const seoTitle = guideTitle(guide.data);

const article = techArticle({
  guide,
  url,
  site: Astro.site,
  image: ogImage,
  published: isoDay(guide.data.date),
  modified: isoDay(guideDate(guide)),
  // Only the tools that really exist: the same rule the chips above follow.
  tools: tools.filter((tool) => tool.known),
});
const breadcrumbs = breadcrumbList({
  site: Astro.site,
  trail: [
    { name: "Home", path: "/" },
    { name: "Guides", path: "/guides/" },
    { name: guide.data.title, path: url },
  ],
});
---

<Base
  title={guide.data.title}
  seoTitle={seoTitle}
  ogTitle={guide.data.title}
  description={seoDescription}
  section="guides"
  ogSlug={ogSlug}
  ogImageAlt={`${guide.data.title}: a tui-tools guide`}
  ogType="article"
  jsonLd={[article, breadcrumbs]}
>
  <div class="page">
    <article class="guide">
      <header class="guide-header">
        <p class="eyebrow"><a href="/guides/">Guides</a></p>
        <h1>{guide.data.title}</h1>
        <p class="lede">{guide.data.description}</p>
        <p class="guide-meta">
          <time datetime={isoDay(guideDate(guide))}>
            published {isoDay(guide.data.date)}
          </time>
          {
            guide.data.updated && (
              <span class="guide-updated">updated {isoDay(guide.data.updated)}</span>
            )
          }
          {
            tools.map((tool) =>
              tool.known ? (
                <a class="chip chip-category" href={`/tools/${tool.name}/`}>
                  {tool.name}
                </a>
              ) : (
                <span class="chip chip-category">{tool.name}</span>
              ),
            )
          }
        </p>
      </header>

      <div class="guide-body prose">
        <Content />
      </div>

      <footer class="guide-footer">
        <p>
          Something here wrong, or out of date? The commands were run on the
          date above and the outputs are transcripts; if a release since then
          behaves differently, that is worth an issue on the tool's repository.{" "}
          <a href="https://github.com/tui-tools" rel="noopener">github.com/tui-tools</a>
        </p>
        <p><a href="/guides/">All guides</a></p>
      </footer>
    </article>
  </div>
</Base>
