---
// The one page shell. `accent` switches the page between the family's green
// and a tool's blue, which is the same rule the branding uses: green is what
// every tool shares, blue is what one tool adds.
import { readFileSync } from "node:fs";
import { createHash } from "node:crypto";
import "../styles/global.css";
import Masthead from "../components/Masthead.astro";
import Footer from "../components/Footer.astro";

const {
  title,
  description,
  accent = "family",
  section = "",
  // The link preview, by name rather than by path: scripts/build-og.mjs draws
  // one 1200x630 card per page into public/og/, and a page only has to say
  // which. Anything without a card of its own falls back to the family one,
  // which is true of 404 and of any page added before its card exists.
  ogSlug = "home",
} = Astro.props;

const fullTitle = title === "tui-tools" ? title : `${title} · tui-tools`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://tui-tools.github.io");

// Absolute, because every scraper that reads these — X, Slack, LinkedIn —
// treats a relative og:image as a reason to show nothing.
// The query string carries a hash of the card's bytes: scrapers cache a preview
// by the image URL, so a redrawn card would otherwise keep showing the old one
// until their cache expired. A missing card (built before its PNG exists) gets
// no version, which is also what the fallback to the family card does.
const ogImage = new URL(`/og/${ogSlug}.png`, canonical);
try {
  const bytes = readFileSync(new URL(`../../public/og/${ogSlug}.png`, import.meta.url));
  ogImage.searchParams.set("v", createHash("sha256").update(bytes).digest("hex").slice(0, 10));
} catch {
  // No card on disk: leave the URL unversioned.
}
---

<!doctype html>
<html lang="en" data-accent={accent}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/brand/icon.svg" />
    <link rel="apple-touch-icon" href="/brand/icon-256.png" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#1a1b26" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="tui-tools" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@edimarlnx" />
    <meta name="twitter:creator" content="@edimarlnx" />
    <meta name="twitter:image" content={ogImage} />
    <style set:html={accent === "tool" ? ":root { --accent: var(--tool); }" : ""} />

    <!-- Umami, self-hosted on Quave ONE. No cookies, no cross-site identifier,
         no personal data: it counts page views and the handful of named events
         listed in the site README. `data-do-not-track` makes it stand down for
         anyone whose browser asks not to be tracked, and `data-domains` keeps
         it quiet on forks and local builds. -->
    <script
      is:inline
      defer
      src="https://analytics.tui.tools/script.js"
      data-website-id="d930a4b8-72ea-43ed-92b0-f159d639210d"
      data-domains="tui-tools.github.io,tui.tools"
      data-do-not-track="true"></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Masthead section={section} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Copying an install command is pressing y on the confirm dialog the
      // tools themselves show. One delegated listener covers every dialog on
      // the page, including the ones the install picker swaps in.
      document.addEventListener("click", async (event) => {
        const button = event.target.closest("[data-copy]");
        if (!button) return;
        const text = button.getAttribute("data-copy");
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          // A browser that refuses the clipboard should not look like a
          // success, so say nothing and leave the command selectable.
          return;
        }
        const label = button.querySelector("[data-copy-label]");
        const previous = label.textContent;
        button.dataset.copied = "true";
        label.textContent = "copied";
        window.setTimeout(() => {
          button.dataset.copied = "false";
          label.textContent = previous;
        }, 1600);
      });
    </script>
  </body>
</html>
