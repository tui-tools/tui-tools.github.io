---
import Base from "../layouts/Base.astro";
import CommandDialog from "../components/CommandDialog.astro";
import catalog from "../data/catalog.json";

const tools = catalog.tools.filter((tool) => !tool.unreleased);
const anyName = tools[0]?.name ?? "tui-firewall";

// One entry per package manager: what you do once per machine, and what you
// then type for any tool in the family. None of the repositories exist yet, so
// every setup block is honest about being the plan rather than the state.
const managers = [
  {
    id: "pacman",
    label: "Arch Linux",
    manager: "pacman",
    setupTitle: "Add the tui-tools repository to /etc/pacman.conf",
    setup: `sudo pacman-key --recv-keys $TUI_TOOLS_KEY_ID
sudo pacman-key --lsign-key $TUI_TOOLS_KEY_ID
printf '[tui-tools]\\nServer = https://pkgs.tui.tools/arch/$arch\\n' \\
  | sudo tee -a /etc/pacman.conf
sudo pacman -Sy`,
    installTitle: "Then install any tool",
    install: `sudo pacman -S ${anyName}`,
  },
  {
    id: "aur",
    label: "Arch Linux (AUR)",
    manager: "an AUR helper",
    setupTitle: "No repository to add",
    setup: `# The AUR needs no setup beyond a helper such as paru or yay.`,
    installTitle: "Build the released binary from the AUR",
    install: `paru -S ${anyName}-bin`,
  },
  {
    id: "apt",
    label: "Debian / Ubuntu",
    manager: "apt",
    setupTitle: "Add the keyring and the repository",
    setup: `curl -fsSL https://pkgs.tui.tools/deb/tui-tools.gpg \\
  | sudo tee /usr/share/keyrings/tui-tools.gpg > /dev/null
echo "deb [signed-by=/usr/share/keyrings/tui-tools.gpg] https://pkgs.tui.tools/deb stable main" \\
  | sudo tee /etc/apt/sources.list.d/tui-tools.list
sudo apt update`,
    installTitle: "Then install any tool",
    install: `sudo apt install ${anyName}`,
  },
  {
    id: "dnf",
    label: "Fedora / RHEL",
    manager: "dnf",
    setupTitle: "Add the .repo file",
    setup: `sudo curl -fsSL -o /etc/yum.repos.d/tui-tools.repo \\
  https://pkgs.tui.tools/rpm/tui-tools.repo
sudo rpm --import https://pkgs.tui.tools/rpm/tui-tools.gpg`,
    installTitle: "Then install any tool",
    install: `sudo dnf install ${anyName}`,
  },
  {
    id: "zypper",
    label: "openSUSE",
    manager: "zypper",
    setupTitle: "Add the repository",
    setup: `sudo zypper addrepo --refresh https://pkgs.tui.tools/rpm tui-tools
sudo rpm --import https://pkgs.tui.tools/rpm/tui-tools.gpg
sudo zypper refresh`,
    installTitle: "Then install any tool",
    install: `sudo zypper install ${anyName}`,
  },
];
---

<Base
  title="Install"
  description="How to install tui-tools: the one-time repository setup for pacman, apt, dnf and zypper, the static binaries that work today, and how to verify a download."
  section="install"
>
  <div class="page">
    <section class="hero" style="grid-template-columns:1fr">
      <div>
        <p class="eyebrow">Install</p>
        <h1>Set the repository up once, then install any tool</h1>
        <p class="lede">
          The family is heading for real distribution packages, so a tool is
          installed the way everything else on your machine is:
          <code>pacman -S</code>, <code>apt install</code>, <code>dnf install</code>.
          The repository behind them is not live yet. What works today is the
          static binary, and it is one command.
        </p>
      </div>
    </section>

    <section class="section" style="padding-top:0" id="today">
      <div class="section-head">
        <h2>Today: the static binary</h2>
        <span class="chip chip-version">works now</span>
      </div>
      <div class="split">
        <div class="stack">
          {
            tools.map((tool) => {
              const binary = tool.install.find((entry) => entry.id === "binary");
              if (!binary) return null;
              return (
                <CommandDialog
                  title={`${tool.name} ${tool.release?.tag ?? ""} · linux/amd64`}
                  command={binary.commands[0].command}
                  tool={tool.name}
                  manager="binary"
                />
              );
            })
          }
        </div>
        <div class="panel">
          <h2>Other architectures</h2>
          <p style="font-size:0.9rem;color:var(--muted)">
            Every release ships <code>linux/amd64</code> and <code>linux/arm64</code>.
            Each tool's page lists both, with the file sizes and the SHA-256 sums
            taken from the release's own <code>checksums.txt</code>.
          </p>
          <p style="font-size:0.9rem;color:var(--muted);margin-bottom:0">
            No installer script runs on your machine, and the tools never check for
            updates: you upgrade by downloading a newer binary.
          </p>
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:0" id="repositories">
      <div class="section-head">
        <h2>Coming: one repository, every tool</h2>
        <span class="chip chip-unreleased">not live yet</span>
      </div>
      <p class="lede" style="max-width:62ch">
        These are the commands the family is building towards. They are written
        down now so the shape is public and reviewable; nothing at
        <code>pkgs.tui.tools</code> answers yet, so running them today will fail.
      </p>

      <div class="stack" style="margin-top:2rem">
        {
          managers.map((manager) => (
            <section class="panel" id={manager.id}>
              <h2>{manager.label}</h2>
              <div class="stack" style="margin-top:0">
                <CommandDialog
                  title={manager.setupTitle}
                  command={manager.setup}
                  manager={manager.id}
                  soon
                />
                <CommandDialog
                  title={manager.installTitle}
                  command={manager.install}
                  tool={anyName}
                  manager={manager.id}
                  soon
                />
              </div>
              <p class="install-note">
                One setup per machine. After it, every tool in the family is a
                <code>{manager.manager}</code> away, and upgrades come with the rest
                of your system updates.
              </p>
            </section>
          ))
        }
      </div>
    </section>

    <section class="section" style="padding-top:0" id="script">
      <div class="section-head">
        <h2>The one-liner</h2>
        <span class="chip chip-unreleased">planned</span>
      </div>
      <div class="split">
        <div>
          <CommandDialog
            title="Detect the package manager and add the repository"
            command="curl -fsSL https://pkgs.tui.tools/install.sh | sh"
            manager="install-script"
            soon
          />
        </div>
        <div class="panel">
          <h2>Read it first</h2>
          <p style="font-size:0.9rem;color:var(--muted);margin-bottom:0">
            A family whose whole promise is <em>preview before you run</em> is not
            going to ask you to pipe a script into a shell without looking at it.
            When this exists, the page it lives on will show the script in full,
            and <code>curl -fsSL … -o install.sh</code> then reading it will be the
            recommended path.
          </p>
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:0" id="verify">
      <div class="section-head">
        <h2>Verify a download</h2>
      </div>
      <div class="split">
        <div class="stack">
          <CommandDialog
            title="Check an archive against the release's checksums.txt"
            command={`curl -fsSLO https://github.com/tui-tools/${anyName}/releases/latest/download/checksums.txt
sha256sum -c checksums.txt --ignore-missing`}
            manager="checksums"
          />
          <p style="color:var(--muted);font-size:0.92rem">
            <code>--ignore-missing</code> checks only the files you actually
            downloaded. The command prints <code>OK</code> per file, and exits
            non-zero if anything does not match.
          </p>
        </div>
        <div class="panel">
          <h2>Signatures</h2>
          <p style="font-size:0.9rem;color:var(--muted);margin-bottom:0">
            Releases are <strong>not signed yet</strong>. The checksums file tells
            you an archive arrived intact; it does not, on its own, prove who built
            it. Signed releases and a signed package repository are the same piece
            of work, and it is the open item on the
            <a href="/security/">security page</a>.
          </p>
        </div>
      </div>
    </section>
  </div>
</Base>
