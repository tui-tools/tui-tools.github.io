---
import Base from "../layouts/Base.astro";
import CommandDialog from "../components/CommandDialog.astro";
import catalog from "../data/catalog.json";
import scorecard from "../data/scorecard.json";

const tools = catalog.tools;

// One row per repository the Scorecard step asked about: the catalog's tools
// plus tui-kit and the tui-tools launcher, which carry no tool.json. A row
// with no published result yet is kept and shown as pending rather than
// dropped, so the table is the whole family either way.
const scorecards = (scorecard.results ?? []).map((result) => ({
  repo: result.repo,
  badge: result.badge,
  viewer: result.viewer,
  published: result.status === "published",
  score: result.score ?? null,
  measured: result.date ? result.date.slice(0, 10) : "—",
  // Everything that is not a 10, weakest first. -1 is Scorecard's "this check
  // could not run here", which the chip prints as n/a rather than as a zero.
  open: (result.checks ?? [])
    .filter((check) => check.score < 10)
    .sort(
      (a, b) =>
        // Real scores first, weakest first; the ones that could not run last.
        (a.score < 0) - (b.score < 0) ||
        a.score - b.score ||
        a.name.localeCompare(b.name),
    ),
}));

const principles = [
  {
    title: "Preview, then confirm",
    body:
      "No tool changes anything without first showing the exact command line. A tool never assembles a shell string: it builds a command value, the confirm dialog displays that value, and the runner receives the same one. The preview cannot drift from what executes, because they are the same object. That is the whole trust boundary, and it is one small package in tui-kit rather than a rule each tool re-implements.",
  },
  {
    title: "Read-only by default",
    body:
      "Starting a tool only reads. Nothing is written, nothing is scheduled, and there is no first-run setup that changes your machine. If a read itself needs root, as ufw's status does, the tool says so instead of silently escalating.",
  },
  {
    title: "Runs as you",
    body:
      "Reads work unprivileged wherever the underlying tool allows it. Only an action escalates, through sudo -n, which never prompts: run sudo -v in another terminal first, or start the tool with sudo. The prefix is configurable, so doas works, and an empty prefix runs the command directly when you are already root.",
  },
  {
    title: "No daemon, no state of its own",
    body:
      "One static binary. Nothing keeps running after you quit, nothing is installed to run later, and no state is kept beside the system's own. The system is the source of truth; a tool re-reads it after every change, so what you see is what the machine reports rather than what the tool assumed.",
  },
  {
    title: "No network",
    body:
      "The tools open no network connection of their own. No telemetry, no update check, no crash reporting, no phone home. Upgrading means downloading a newer binary, on purpose.",
  },
  {
    title: "--demo always works",
    body:
      "Every tool runs against in-memory sample data with --demo. Every key works and every command is built and previewed for real; the fake runner records what it was asked to run and answers from a table, so nothing reaches your system. It exists so a reviewer can read the previews before ever pointing a tool at a real machine.",
  },
];

const rows = tools.map((tool) => ({
  name: tool.name,
  sudo: tool.security.needs_sudo === false ? "never" : "actions only",
  daemon: tool.security.no_daemon,
  network: tool.security.no_network,
  static: tool.security.static_binary,
  signed: tool.security.signed_releases,
}));

function mark(value) {
  return value ? "✓" : "✕";
}
---

<Base
  title="Security"
  description="How tui-tools behave: preview then confirm, read-only by default, no daemon, no network, static binaries, and how to verify a download."
  section="security"
  ogSlug="security"
>
  <div class="page">
    <section class="hero" style="grid-template-columns:1fr">
      <div>
        <p class="eyebrow">Security</p>
        <h1>What these tools can, and cannot, do to your machine</h1>
        <p class="lede">
          These are front ends for programs that change a running system. That is
          worth being precise about rather than reassuring about. Here is every
          promise the family makes, what each one is worth, and the one that is
          still an open item.
        </p>
      </div>
    </section>

    <section class="section" style="padding-top:0">
      <div class="section-head"><h2>The principles</h2></div>
      <div class="grid">
        {
          principles.map((principle) => (
            <div class="panel">
              <h3>{principle.title}</h3>
              <p style="font-size:0.93rem;color:color-mix(in srgb, var(--fg) 80%, var(--muted));margin-bottom:0">
                {principle.body}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section" style="padding-top:0" id="gate">
      <div class="section-head">
        <h2>What the gate checks</h2>
        <span class="chip">every tag, every package</span>
      </div>
      <div class="grid">
        <div class="panel">
          <h3>Before a tag becomes a release</h3>
          <p style="font-size:0.93rem;color:color-mix(in srgb, var(--fg) 80%, var(--muted));margin-bottom:0">
            The <code>security</code> job runs <code>govulncheck</code> over the
            code the build actually reaches and <code>gitleaks</code> over both
            the working tree and the whole git history, because a secret
            committed once stays reachable long after the commit that removed
            it. <code>gosec</code> runs earlier, inside the lint bar. The
            release job needs the security job to be green; a red one is a tag
            without a release.
          </p>
        </div>
        <div class="panel">
          <h3>What ships beside the binaries</h3>
          <p style="font-size:0.93rem;color:color-mix(in srgb, var(--fg) 80%, var(--muted));margin-bottom:0">
            A CycloneDX SBOM per archive, a keyless cosign signature over
            <code>checksums.txt</code> as a Sigstore bundle, and SLSA build
            provenance attested for every archive, every package and the
            checksum file. None of it needs a key to be distributed: both
            signatures are tied to the workflow identity GitHub issued at build
            time.
          </p>
        </div>
        <div class="panel">
          <h3>Before a package enters the repository</h3>
          <p style="font-size:0.93rem;color:color-mix(in srgb, var(--fg) 80%, var(--muted));margin-bottom:0">
            <a href="https://pkgs.tui.tools" rel="noopener">pkgs.tui.tools</a>
            accepts a package only if its sha256 matches the release's
            <code>checksums.txt</code>, that file carries a valid cosign
            signature from the tool's own release workflow,
            <code>gh attestation verify</code> passes on the file itself, and
            trivy finds no HIGH or CRITICAL vulnerability inside it. Any one
            failing rejects the package and fails the build; there is no
            warn-only mode. These are in addition to the repository's GPG
            signatures, not instead of them: provenance and the scan are about
            what may go in, the GPG signatures are what your machine checks on
            the way out.
          </p>
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:0" id="scorecard">
      <div class="section-head">
        <h2>Scorecard</h2>
        <span class="chip">OpenSSF, weekly</span>
      </div>
      <p class="install-note" style="margin-top:0">
        The score is the aggregate of the 18 checks
        <a href="https://github.com/ossf/scorecard" rel="noopener">OpenSSF Scorecard</a>
        runs weekly against each repository, and it is the same number the badge
        in that repository's README shows. The chips are every check that did
        not score 10, so what is still open is on this page rather than one
        click away.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Repository</th>
              <th scope="col">Badge</th>
              <th scope="col">Score</th>
              <th scope="col">Measured</th>
              <th scope="col">Below 10</th>
            </tr>
          </thead>
          <tbody>
            {
              scorecards.map((row) => (
                <tr>
                  <td class="mono">
                    <a href={`https://github.com/tui-tools/${row.repo}`} rel="noopener">
                      {row.repo}
                    </a>
                  </td>
                  <td>
                    <a href={row.viewer} rel="noopener">
                      <img
                        src={row.badge}
                        alt={`OpenSSF Scorecard for ${row.repo}`}
                        height="20"
                        loading="lazy"
                        style="display:block;height:20px;width:auto"
                      />
                    </a>
                  </td>
                  <td class="mono" style={row.published ? "color:var(--family)" : "color:var(--soon)"}>
                    {row.published ? row.score.toFixed(1) : "pending"}
                  </td>
                  <td class="mono" style="color:var(--muted)">{row.measured}</td>
                  <td>
                    {row.published ? (
                      <div class="chips">
                        {row.open.length === 0 ? (
                          <span class="chip chip-version">all 18 at 10</span>
                        ) : (
                          row.open.map((check) => (
                            <span
                              class:list={["chip", check.score < 0 ? "" : "chip-unreleased"]}
                              title={check.reason ?? undefined}
                            >
                              {check.name} {check.score < 0 ? "n/a" : check.score}
                            </span>
                          ))
                        )}
                      </div>
                    ) : (
                      <span style="color:var(--muted);font-size:0.85rem">
                        the first weekly run has not been indexed yet
                      </span>
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="section" style="padding-top:0" id="verify-release">
      <div class="section-head">
        <h2>Verify a release yourself</h2>
        <span class="chip">tui-firewall, as the example</span>
      </div>
      <div class="split">
        <div class="stack">
          <CommandDialog
            title="Was this file built by that repository's workflow?"
            command="gh attestation verify tui-firewall_0.2.2_amd64.deb -R tui-tools/tui-firewall"
          />
          <CommandDialog
            title="Is the checksum list signed by that repository's ci.yml, on a tag?"
            command={`cosign verify-blob \\
  --bundle checksums.txt.sigstore.json \\
  --certificate-identity-regexp \\
    '^https://github.com/tui-tools/tui-firewall/\\.github/workflows/ci\\.yml@refs/tags/v' \\
  --certificate-oidc-issuer https://token.actions.githubusercontent.com \\
  checksums.txt`}
          />
          <CommandDialog
            title="Are the bytes you downloaded the ones that list names?"
            command="sha256sum -c --ignore-missing checksums.txt"
          />
        </div>
        <div class="panel">
          <h2>Why the regexp is the point</h2>
          <p style="font-size:0.9rem;color:var(--muted)">
            The identity regexp says the signature has to come from that
            repository's <code>ci.yml</code>, running on a tag. Without it,
            <code>cosign</code> would accept anything signed by anyone. Replace
            <code>tui-firewall</code> with the tool you are verifying;
            everything else is identical across the family.
          </p>
          <p style="font-size:0.9rem;color:var(--muted);margin-bottom:0">
            Every asset of every release, with its SHA-256 as parsed from
            <code>checksums.txt</code> at build time, is also in
            <a href="/catalog.json">catalog.json</a>, so you can compare before
            downloading anything.
          </p>
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:0" id="matrix">
      <div class="section-head">
        <h2>Every tool, answered</h2>
        <span class="chip">from each tool.json</span>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Tool</th>
              <th scope="col">Escalates</th>
              <th scope="col">No daemon</th>
              <th scope="col">No network</th>
              <th scope="col">Static</th>
              <th scope="col">Signed releases</th>
            </tr>
          </thead>
          <tbody>
            {
              rows.map((row) => (
                <tr>
                  <td class="mono"><a href={`/tools/${row.name}/`}>{row.name}</a></td>
                  <td class="mono">{row.sudo}</td>
                  <td class="mono" style="color:var(--family)">{mark(row.daemon)}</td>
                  <td class="mono" style="color:var(--family)">{mark(row.network)}</td>
                  <td class="mono" style="color:var(--family)">{mark(row.static)}</td>
                  <td class="mono" style={row.signed ? "color:var(--family)" : "color:var(--soon)"}>
                    {mark(row.signed)}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="install-note">
        The last column is what each tool.json still declares, and it is behind
        the facts: releases now carry cosign signatures and build provenance,
        as <a href="#gate">the gate</a> above describes. The manifests are
        updated tool by tool, and this column follows them rather than
        anticipating them.
      </p>
    </section>

    <section class="section" style="padding-top:0" id="sudo">
      <div class="section-head"><h2>How sudo is used</h2></div>
      <div class="split">
        <div class="prose">
          <p>
            A tool resolves the binary it drives — <code>ufw</code>,
            <code>systemctl</code> — to an absolute path, and prefixes it with the
            escalation prefix from its configuration. The default is
            <code>sudo -n</code>: the <code>-n</code> means non-interactive, so it
            never prompts. If your sudo timestamp has expired, the command fails
            and the tool tells you, rather than a password box appearing inside a
            TUI where you cannot tell what is reading it.
          </p>
          <p>
            The whole prefix is one configuration value. Set it to
            <code>doas</code>, or to the empty string when you are already root:
          </p>
        </div>
        <div class="stack">
          <CommandDialog title="Warm the sudo timestamp first" command="sudo -v" />
          <CommandDialog
            title="Or run the command directly, as root"
            command="sudo tui-firewall --sudo ''"
          />
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:0" id="verify">
      <div class="section-head"><h2>Verifying a download</h2></div>
      <div class="split">
        <div class="stack">
          <CommandDialog
            title="Check the archive against the release's own checksums.txt"
            command={`curl -fsSLO https://github.com/tui-tools/tui-firewall/releases/latest/download/checksums.txt
sha256sum -c checksums.txt --ignore-missing`}
          />
          <p style="color:var(--muted);font-size:0.92rem;max-width:60ch">
            Each tool's page lists the SHA-256 of every asset, parsed from that same
            file at build time, so you can compare without downloading anything
            first. <code>--ignore-missing</code> checks only what you have.
          </p>
        </div>
        <div class="panel">
          <h2>What a checksum proves</h2>
          <p style="font-size:0.9rem;color:var(--muted)">
            That the file arrived intact from the same place the checksum did.
            Both come from the GitHub release, so this catches corruption and a
            broken mirror, not a compromised release.
          </p>
          <p style="font-size:0.9rem;color:var(--muted);margin-bottom:0">
            Signatures close that gap, and they are in place:
            <a href="#verify-release">verify a release yourself</a> is the
            check that answers who built the file, not just whether it arrived
            intact.
          </p>
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:0" id="reporting">
      <div class="section-head"><h2>Reporting a vulnerability</h2></div>
      <div class="split">
        <div class="prose">
          <p>
            Report privately, through GitHub's private vulnerability reporting on
            the affected repository's <strong>Security</strong> tab. Do not open a
            public issue. Expect a first reply within a week; this is a small
            project maintained in spare time, and there is no bounty.
          </p>
          <p>
            <strong>In scope</strong> is anything that breaks the trust boundary: a
            command that executes without having been previewed and confirmed; a
            preview that does not match what is executed; an argument taken from a
            config file, a theme file or parsed command output that reaches a shell
            or changes the meaning of a command line; escalation beyond the
            configured prefix.
          </p>
          <p style="margin-bottom:0">
            <strong>Not in scope</strong> is anything you can already do with the
            underlying tool at the same privilege level. These are terminal front
            ends, not a privilege boundary of their own. Needing root to change the
            system is the design, and locking yourself out of a machine with a rule
            that does so is something the tools warn about but do not
            second-guess.
          </p>
        </div>
        <div class="panel">
          <h2>Per-repository policy</h2>
          <ul style="list-style:none;padding:0;margin:0;display:grid;gap:0.4rem">
            {
              tools.map((tool) => (
                <li class="mono" style="font-size:0.85rem">
                  <a href={`${tool.repo}/security/policy`} rel="noopener">
                    {tool.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>
  </div>
</Base>
